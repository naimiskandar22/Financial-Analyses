name: Upload CSV to Firestore

# Manual, one-off run: Actions tab → "Upload CSV to Firestore" → Run workflow
on:
  workflow_dispatch:
    inputs:
      csv_path:
        description: "Path to the CSV file in the repo"
        required: true
        default: "NVDA_prices.csv"
      collection:
        description: "Firestore collection name"
        required: true
        default: "NVDA_prices"

jobs:
  upload:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.GCP_SA_KEY }}

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: "pip"

      - name: Install dependencies
        run: python -m pip install pandas firebase-admin

      - name: Upload CSV to Firestore
        env:
          CSV_PATH: ${{ inputs.csv_path }}
          COLLECTION_NAME: ${{ inputs.collection }}
        run: python scripts/upload_csv_to_firestore.py
